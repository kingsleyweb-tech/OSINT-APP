PORT=5000
NODE_ENV=development
FIREBASE_PROJECT_ID=your_firebase_project_id
GITHUB_TOKEN=your_optional_github_token
SERPAPI_KEY=your_serpapi_key_here
# Optional: hours a SerpApi response is reused before the same query is billed again (default 12, 0 disables caching)
SERPAPI_CACHE_TTL_HOURS=12
# Optional: directory where cached SerpApi responses are also written, so the cache survives restarts
SERPAPI_CACHE_DIR=

# ── Keyword alerts ──
# Firebase service account JSON on ONE line (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT=
# Email through Brevo's HTTPS API (brevo.com → SMTP & API → API keys); MAIL_FROM must be a verified sender in Brevo
BREVO_API_KEY=
MAIL_FROM=you@example.com
SMTP_FROM_NAME=OSINT Alerts
# Optional instead of Brevo: SMTP (used only when BREVO_API_KEY is empty)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Reference only (not read by the app): Brevo's SMTP relay details, if you ever want them at hand
# BREVO_SMTP_KEY=
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_LOGIN=
# Long random secret the scheduler (cron-job.org) sends in the x-cron-secret header to POST /api/alerts/cron
ALERTS_CRON_SECRET=
# Site address used in email links
APP_URL=https://your-site.vercel.app
# SerpApi budget for alerts
ALERTS_MAX_SEARCHES_PER_DAY=8
ALERTS_QUOTA_RESERVE=25
